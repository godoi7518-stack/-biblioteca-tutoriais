# Copie este arquivo para .env (na pasta backend) e preencha com os seus valores.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=biblioteca_tutoriais

# Gere uma chave aleatória, ex.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
