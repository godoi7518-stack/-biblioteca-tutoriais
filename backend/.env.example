# Copie este arquivo para .env (na pasta backend) e preencha com os seus valores.
# No deploy, estas mesmas variáveis são cadastradas no painel da hospedagem
# (o arquivo .env não vai para o servidor). Passo a passo: DEPLOY.md.

# --- Banco de dados ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=biblioteca_tutoriais
# true = imprime todo o SQL no terminal (só para depurar).
DB_ECHO=false
# Caminho do certificado CA do banco. Vazio no MySQL local; obrigatório
# para bancos na nuvem que exigem SSL (ex.: Aiven).
DB_SSL_CA=

# --- Autenticação ---
# Gere uma chave aleatória, ex.: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Use uma chave DIFERENTE no deploy. Quem tem a chave consegue criar tokens
# de login válidos para qualquer usuário.
SECRET_KEY=troque-esta-chave
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Frontend (CORS) ---
# Endereços do frontend que podem chamar a API, separados por vírgula.
CORS_ORIGINS=http://localhost:5173

# --- Imagens ---
# local = pasta static/uploads | r2 = Cloudflare R2 (produção)
STORAGE_BACKEND=local
# Preencher só com STORAGE_BACKEND=r2:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Endereço público do bucket, sem "/" no fim (ex.: https://pub-xxxx.r2.dev)
R2_PUBLIC_URL=
