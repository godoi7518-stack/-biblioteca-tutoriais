# Copie para frontend/.env se precisar apontar para outra API.
# Sem este arquivo, o site usa o backend local (http://127.0.0.1:8000).
# No deploy, cadastre VITE_API_URL nas variáveis do serviço do frontend
# (sem "/" no fim). O valor entra no build: mudou, precisa gerar de novo.
VITE_API_URL=http://127.0.0.1:8000
